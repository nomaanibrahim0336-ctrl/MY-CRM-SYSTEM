generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id             String     @id @default(cuid())
  title          String
  description    String?
  stage          String     @default("new_client")
  revisionCount  Int        @default(0)
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  comments       Comment[]
  history        StageHistory[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  author    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model StageHistory {
  id        String   @id @default(cuid())
  fromStage String
  toStage   String
  note      String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
