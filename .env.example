# Railway PostgreSQL connection strings
# Get these from: Railway Dashboard → Your Postgres service → Variables tab

# Used by the app at runtime (copy DATABASE_PUBLIC_URL from Railway)
DATABASE_URL="postgresql://postgres:[password]@[host].railway.app:[port]/railway"

# Used by Prisma migrations — same value as DATABASE_URL on Railway
DIRECT_URL="postgresql://postgres:[password]@[host].railway.app:[port]/railway"
